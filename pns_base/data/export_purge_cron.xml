<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Deletes exported files older than
         pns_base.export_retention_hours (24 by default; 0 = keep them).
         Stack owl2: no numbercall/doall. -->
    <record id="ir_cron_pns_export_purge" model="ir.cron">
        <field name="name">PNS: delete old export files</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_pns_exports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
